datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

// Модель пользователя
model User {
  id         Int    @id @default(autoincrement())
  username   String @unique
  password   String
  starsCount Int    @default(0) // Всего заработанных звезд за все игры
  winsCount  Int    @default(0) //  Количество побед в квизах
  quizzes    Quiz[]
}

// Модель квиза
model Quiz {
  id          Int        @id @default(autoincrement())
  title       String
  description String?
  playCount   Int        @default(0)
  createdAt   DateTime   @default(now())
  authorId    Int
  author      User       @relation(fields: [authorId], references: [id])
  questions   Question[]
}

// НОВАЯ МОДЕЛЬ: История прошедших игр
model GameHistory {
  id           Int      @id @default(autoincrement())
  quizTitle    String // Название сыгранного квиза
  winnerName   String // Имя победителя
  playersCount Int // Сколько участников играло
  resultsJson  String   @default("[]")
  playedAt     DateTime @default(now()) // Время игры
}

// Модель вопроса
model Question {
  id        Int      @id @default(autoincrement())
  text      String
  timeLimit Int      @default(30)
  quizId    Int
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers   Answer[]
}

// Модель ответа
model Answer {
  id         Int      @id @default(autoincrement())
  text       String
  isCorrect  Boolean  @default(false)
  questionId Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}
